{
  "name": "mp-ukagaka",
  "version": "1.0.0",
  "description": "A WordPress plugin for creating interactive ukagaka (伺か) characters with AI-powered features.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "example"
  },
  "scripts": {
    "build": "cd ../.. && node tools/node/build.js",
    "inventory:logs": "cd ../.. && node tools/node/generate-console-log-inventory.js",
    "test:logger": "cd ../.. && node tools/node/test-logger-smoke.js",
    "test:visual-ready": "cd ../.. && node tools/node/test-visual-ready-smoke.js",
    "test:chat-integrity-window": "cd ../.. && node tools/node/test-chat-integrity-window-smoke.js",
    "test:chat-transport": "cd ../.. && node tools/node/test-chat-transport-smoke.js",
    "test:gift-message": "cd ../.. && node tools/node/test-gift-message-smoke.js",
    "lint:css": "cd ../.. && stylelint css/mpu_style.css --config-basedir tools/node",
    "lint:css:fix": "cd ../.. && stylelint css/mpu_style.css --config-basedir tools/node --fix",
    "visual:baseline": "cd ../.. && node tools/visual/frontend-css-visual.js baseline",
    "visual:compare": "cd ../.. && node tools/visual/frontend-css-visual.js compare",
    "lint:php": "cd ../.. && php -r \"$e=0;foreach(new RecursiveIteratorIterator(new RecursiveDirectoryIterator('includes')) as $f){if($f->getExtension()==='php'){$r=0;passthru('php -l '.escapeshellarg($f),$r);$e|=$r;}}foreach(new RecursiveIteratorIterator(new RecursiveDirectoryIterator('options')) as $f){if($f->getExtension()==='php'){$r=0;passthru('php -l '.escapeshellarg($f),$r);$e|=$r;}}$r=0;passthru('php -l mp-ukagaka.php',$r);$e|=$r;exit($e);\"",
    "version:set": "cd ../.. && node tools/node/bump-version.js",
    "version:check": "cd ../.. && node tools/node/bump-version.js --check",
    "lint:phpcs": "cd ../.. && php tools/php/phpcs-baseline.php check",
    "lint:phpcs:baseline": "cd ../.. && php tools/php/phpcs-baseline.php generate",
    "lint:phpcs:summary": "cd ../.. && php tools/php/phpcs-baseline.php summary",
    "test:php": "cd ../../tests && php ../tools/php/vendor/bin/phpunit --colors=always",
    "verify": "npm run version:check && npm run lint:php && npm run lint:phpcs && npm run lint:css && npm run test:logger && npm run test:visual-ready && npm run test:chat-integrity-window && npm run test:chat-transport && npm run test:gift-message && npm run build && npm run test:php",
    "translate:en": "cd ../.. && node tools/node/translate-po.js",
    "test": "npm run test:php"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Horlicks-p/mp-ukagaka.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Horlicks-p/mp-ukagaka/issues"
  },
  "homepage": "https://github.com/Horlicks-p/mp-ukagaka#readme",
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.44.1"
  }
}
