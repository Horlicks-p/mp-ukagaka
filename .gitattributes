# Line-ending normalization policy.
# Text files commit/checkout as LF so the PHPCS baseline is portable across machines.
# .bat/.cmd/.ps1 stay CRLF; images and compiled .mo are binary.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mo   binary

# Release packaging. release.yml builds mp-ukagaka.zip with `git archive`, which
# ships every tracked path unless it is marked export-ignore. These are
# development-only and have no business in a user's wp-content/plugins.
# docs-en/, example/, the READMEs and the screenshots stay: users read those.
.github/        export-ignore
plan/           export-ignore
tests/          export-ignore
tools/          export-ignore
phpcs.xml.dist  export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
AGENTS.md       export-ignore
CLAUDE.md       export-ignore
GEMINI.md       export-ignore
